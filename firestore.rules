rules_version = '2';

// NOTE: This ruleset is intentionally wide open — every collection is readable
// and writable by anyone, matching what was already live in the console. That
// is what lets an account-less customer send a quotation from the public
// catalogue, but it also exposes orders, dealers, agents and their commissions
// to the whole internet. It should be tightened per-collection before long.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
