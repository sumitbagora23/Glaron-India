rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images: anyone can view them (public catalog), only signed-in
    // users (admins) can upload or change them.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else: readable publicly, writable only when authenticated.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
